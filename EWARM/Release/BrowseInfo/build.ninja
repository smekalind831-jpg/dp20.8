##IAR Ninja build file


#Rules
rule COMPILER_XCL
  command = "C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 9.5\common\bin\XclFileGenerator.exe" $xclcommand -f "$rspfile_name"
  description = IAR_NEW_TOOL+++COMPILER_XCL+++$out
  rspfile = $rspfile_name
  rspfile_content = $flags

rule INDEXER
  command = "C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 9.5\common\bin\SourceIndexer.exe" $flags
  depfile = $out.dep
  deps = gcc
  description = IAR_NEW_TOOL+++INDEXER+++$out

rule MAKEBROWSE
  command = "C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 9.5\common\bin\makeBrowseData.exe" $flags
  description = IAR_NEW_TOOL+++MAKEBROWSE+++$out

rule PDBLINK
  command = "C$:\Program$ Files$ (x86)\IAR$ Systems\Embedded$ Workbench$ 9.5\common\bin\PbdLink.exe" $flags
  description = IAR_NEW_TOOL+++PDBLINK+++$out



